# GeoMeasure Pro Environment Configuration

# FastAPI Backend URL for Frontend
VITE_API_BASE_URL="http://localhost:8000"

# Backend Configuration (for backend/.env)
PROJECT_NAME="GeoMeasure Pro API"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database Configuration
POSTGRES_USER="geomeasure_user"
POSTGRES_PASSWORD="geomeasure_password"
POSTGRES_DB="geomeasure_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://geomeasure_user:geomeasure_password@localhost:5432/geomeasure_db"

# Geospatial Processing Limits
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
MAX_FEATURES_PER_FILE=10000
DEFAULT_PROJECTED_CRS="AUTO_UTM"  # Automatically picks optimal UTM zone based on dataset centroid
